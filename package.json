{
  "name": "github-contributions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "fetch": "tsx scripts/fetch-contributions.ts",
    "generate": "tsx scripts/generate-svg.tsx",
    "generate:mock": "tsx scripts/generate-svg.tsx --mock",
    "update": "npm run fetch && npm run generate"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
